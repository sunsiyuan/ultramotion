[{"start": 0.94, "end": 3.52, "text": " This is Houston. Are you ready for the event?", "words": [[0.94, 1.18, "This"], [1.18, 1.76, "is"], [1.76, 2.0, "Houston."], [2.4, 2.5, "Are"], [2.5, 2.66, "you"], [2.66, 2.9, "ready"], [2.9, 3.16, "for"], [3.16, 3.28, "the"], [3.28, 3.52, "event?"]]}, {"start": 4.6, "end": 6.2, "text": " Houston, this is Station. I'm ready.", "words": [[4.6, 5.06, "Houston,"], [5.2, 5.3, "this"], [5.3, 5.4, "is"], [5.4, 5.68, "Station."], [5.88, 6.02, "I'm"], [6.02, 6.2, "ready."]]}, {"start": 13.46, "end": 19.28, "text": " Hi, I'm Christina Cook. This is Ask NASA, where we answer your questions even in space.", "words": [[13.46, 13.7, "Hi,"], [13.98, 14.14, "I'm"], [14.14, 14.46, "Christina"], [14.46, 14.74, "Cook."], [15.26, 15.46, "This"], [15.46, 15.68, "is"], [15.68, 15.98, "Ask"], [15.98, 16.42, "NASA,"], [16.8, 16.9, "where"], [16.9, 17.08, "we"], [17.08, 17.36, "answer"], [17.36, 17.5, "your"], [17.5, 17.94, "questions"], [17.94, 18.78, "even"], [18.78, 19.06, "in"], [19.06, 19.28, "space."]]}, {"start": 20.2, "end": 30.51, "text": " What personal space achievement are you most proud of?", "words": [[20.2, 20.68, "What"], [27.85, 28.33, "personal"], [28.33, 28.63, "space"], [28.63, 29.29, "achievement"], [29.29, 29.63, "are"], [29.63, 29.77, "you"], [29.77, 30.01, "most"], [30.01, 30.25, "proud"], [30.25, 30.51, "of?"]]}, {"start": 31.21, "end": 35.39, "text": " Well, having been here for over 300 days, I have to say there are a lot of things", "words": [[31.21, 31.39, "Well,"], [31.45, 31.71, "having"], [31.71, 31.91, "been"], [31.91, 32.17, "here"], [32.17, 32.57, "for"], [32.57, 33.33, "over"], [33.33, 33.57, "300"], [33.57, 33.95, "days,"], [34.11, 34.15, "I"], [34.15, 34.27, "have"], [34.27, 34.37, "to"], [34.37, 34.59, "say"], [34.59, 34.79, "there"], [34.79, 34.87, "are"], [34.87, 34.95, "a"], [34.95, 35.09, "lot"], [35.09, 35.19, "of"], [35.19, 35.39, "things"]]}, {"start": 35.39, "end": 40.81, "text": " I've had the opportunity and privilege to do that have been something to feel proud of for me.", "words": [[35.39, 35.75, "I've"], [35.75, 35.97, "had"], [35.97, 36.21, "the"], [36.21, 36.73, "opportunity"], [36.73, 36.97, "and"], [36.97, 37.17, "privilege"], [37.17, 37.53, "to"], [37.53, 37.81, "do"], [37.81, 38.45, "that"], [38.45, 38.71, "have"], [38.71, 38.97, "been"], [38.97, 39.35, "something"], [39.35, 39.77, "to"], [39.77, 39.97, "feel"], [39.97, 40.27, "proud"], [40.27, 40.45, "of"], [40.45, 40.61, "for"], [40.61, 40.81, "me."]]}, {"start": 40.81, "end": 45.81, "text": " But most of all I would say it's giving back and contributing to this program", "words": [[40.81, 41.49, "But"], [41.49, 41.83, "most"], [41.83, 41.99, "of"], [41.99, 42.15, "all"], [42.15, 42.25, "I"], [42.25, 42.37, "would"], [42.37, 42.67, "say"], [42.67, 43.17, "it's"], [43.17, 43.41, "giving"], [43.41, 43.75, "back"], [43.75, 44.03, "and"], [44.03, 44.49, "contributing"], [44.49, 45.05, "to"], [45.05, 45.43, "this"], [45.43, 45.81, "program"]]}, {"start": 45.81, "end": 48.31, "text": " that I've held in such high regard my entire life.", "words": [[45.81, 46.01, "that"], [46.01, 46.17, "I've"], [46.17, 46.29, "held"], [46.29, 46.43, "in"], [46.43, 46.59, "such"], [46.59, 47.07, "high"], [47.07, 47.37, "regard"], [47.37, 47.61, "my"], [47.61, 47.83, "entire"], [47.83, 48.31, "life."]]}, {"start": 48.59, "end": 51.41, "text": " Giving back to the teams that have made it possible for me to be here.", "words": [[48.59, 48.85, "Giving"], [48.85, 49.05, "back"], [49.05, 49.21, "to"], [49.21, 49.31, "the"], [49.31, 49.65, "teams"], [49.65, 49.85, "that"], [49.85, 49.97, "have"], [49.97, 50.07, "made"], [50.07, 50.15, "it"], [50.15, 50.43, "possible"], [50.43, 50.73, "for"], [50.73, 50.95, "me"], [50.95, 51.09, "to"], [51.09, 51.19, "be"], [51.19, 51.41, "here."]]}, {"start": 51.75, "end": 56.13, "text": " Training teams, engineering teams, real-time operations teams on the ground,", "words": [[51.75, 51.95, "Training"], [51.95, 52.31, "teams,"], [52.59, 52.83, "engineering"], [52.83, 53.43, "teams,"], [54.15, 54.37, "real"], [54.37, 54.63, "-time"], [54.63, 55.03, "operations"], [55.03, 55.49, "teams"], [55.49, 55.73, "on"], [55.73, 55.85, "the"], [55.85, 56.13, "ground,"]]}, {"start": 56.27, "end": 58.75, "text": " and of course my team up here, my crewmates.", "words": [[56.27, 56.45, "and"], [56.45, 56.63, "of"], [56.63, 56.79, "course"], [56.79, 57.07, "my"], [57.07, 57.49, "team"], [57.49, 57.91, "up"], [57.91, 58.11, "here,"], [58.21, 58.35, "my"], [58.35, 58.75, "crewmates."]]}, {"start": 59.81, "end": 65.49, "text": " If you could pick where in space would you go now? Station again? Moon? Mars?", "words": [[59.81, 60.35, "If"], [60.35, 60.47, "you"], [60.47, 60.65, "could"], [60.65, 60.93, "pick"], [60.93, 61.49, "where"], [61.49, 61.77, "in"], [61.77, 62.07, "space"], [62.07, 62.39, "would"], [62.39, 62.57, "you"], [62.57, 62.77, "go"], [62.77, 63.11, "now?"], [63.47, 63.83, "Station"], [63.83, 64.17, "again?"], [64.73, 64.91, "Moon?"], [65.29, 65.49, "Mars?"]]}, {"start": 66.83, "end": 70.07, "text": " I'd have to say that I would go to Mars.", "words": [[66.83, 67.31, "I'd"], [67.31, 67.45, "have"], [67.45, 67.59, "to"], [67.59, 67.89, "say"], [67.89, 68.53, "that"], [68.53, 69.13, "I"], [69.13, 69.31, "would"], [69.31, 69.59, "go"], [69.59, 69.83, "to"], [69.83, 70.07, "Mars."]]}, {"start": 70.87, "end": 75.11, "text": " And the reason I say that is because I think going deeper into space", "words": [[70.87, 71.27, "And"], [71.27, 71.49, "the"], [71.49, 71.71, "reason"], [71.71, 71.93, "I"], [71.93, 72.13, "say"], [72.13, 72.39, "that"], [72.39, 72.59, "is"], [72.59, 72.89, "because"], [72.89, 73.63, "I"], [73.63, 73.85, "think"], [73.85, 74.09, "going"], [74.09, 74.45, "deeper"], [74.45, 74.71, "into"], [74.71, 75.11, "space"]]}, {"start": 75.11, "end": 78.69, "text": " and answering some of the most fundamental questions that we have", "words": [[75.11, 75.95, "and"], [75.95, 76.25, "answering"], [76.25, 76.49, "some"], [76.49, 76.61, "of"], [76.61, 76.69, "the"], [76.69, 76.91, "most"], [76.91, 77.25, "fundamental"], [77.25, 77.79, "questions"], [77.79, 78.13, "that"], [78.13, 78.27, "we"], [78.27, 78.69, "have"]]}, {"start": 79.27, "end": 81.67, "text": " is one of the most important things we can do at NASA.", "words": [[79.27, 79.75, "is"], [79.75, 79.99, "one"], [79.99, 80.07, "of"], [80.07, 80.15, "the"], [80.15, 80.31, "most"], [80.31, 80.57, "important"], [80.57, 80.83, "things"], [80.83, 81.01, "we"], [81.01, 81.17, "can"], [81.17, 81.31, "do"], [81.31, 81.45, "at"], [81.45, 81.67, "NASA."]]}, {"start": 82.09, "end": 85.47, "text": " I think that going back to the moon first to prove out the technologies needed", "words": [[82.09, 82.25, "I"], [82.25, 82.41, "think"], [82.41, 82.55, "that"], [82.55, 82.73, "going"], [82.73, 82.95, "back"], [82.95, 83.09, "to"], [83.09, 83.19, "the"], [83.19, 83.41, "moon"], [83.41, 83.77, "first"], [83.77, 84.05, "to"], [84.05, 84.25, "prove"], [84.25, 84.39, "out"], [84.39, 84.51, "the"], [84.51, 85.09, "technologies"], [85.09, 85.47, "needed"]]}, {"start": 85.47, "end": 87.79, "text": " for that deeper space mission is really important,", "words": [[85.47, 85.69, "for"], [85.69, 85.87, "that"], [85.87, 86.11, "deeper"], [86.11, 86.35, "space"], [86.35, 86.75, "mission"], [86.75, 86.99, "is"], [86.99, 87.37, "really"], [87.37, 87.79, "important,"]]}, {"start": 88.03, "end": 90.69, "text": " and that's why I'm so excited that's what's on the horizon for us", "words": [[88.03, 88.33, "and"], [88.33, 88.53, "that's"], [88.53, 88.67, "why"], [88.67, 88.79, "I'm"], [88.79, 88.97, "so"], [88.97, 89.29, "excited"], [89.29, 89.59, "that's"], [89.59, 89.77, "what's"], [89.77, 89.89, "on"], [89.89, 89.99, "the"], [89.99, 90.29, "horizon"], [90.29, 90.55, "for"], [90.55, 90.69, "us"]]}, {"start": 90.69, "end": 92.41, "text": " in the 2020s with the Artemis mission.", "words": [[90.69, 90.83, "in"], [90.83, 90.91, "the"], [90.91, 91.57, "2020s"], [91.57, 91.71, "with"], [91.71, 91.81, "the"], [91.81, 92.09, "Artemis"], [92.09, 92.41, "mission."]]}, {"start": 93.53, "end": 97.89, "text": " After nearly a year in space are you ready to come home or would you stay longer?", "words": [[93.53, 93.99, "After"], [93.99, 94.27, "nearly"], [94.27, 94.61, "a"], [94.61, 94.85, "year"], [94.85, 95.01, "in"], [95.01, 95.25, "space"], [95.25, 95.81, "are"], [95.81, 95.97, "you"], [95.97, 96.21, "ready"], [96.21, 96.35, "to"], [96.35, 96.53, "come"], [96.53, 96.83, "home"], [96.83, 97.09, "or"], [97.09, 97.27, "would"], [97.27, 97.39, "you"], [97.39, 97.59, "stay"], [97.59, 97.89, "longer?"]]}, {"start": 98.85, "end": 100.13, "text": " I would say it's a little bit of both.", "words": [[98.85, 98.91, "I"], [98.91, 99.05, "would"], [99.05, 99.23, "say"], [99.23, 99.39, "it's"], [99.39, 99.49, "a"], [99.49, 99.61, "little"], [99.61, 99.77, "bit"], [99.77, 99.89, "of"], [99.89, 100.13, "both."]]}, {"start": 100.49, "end": 102.91, "text": " I am ready to come home and see my friends and loved ones,", "words": [[100.49, 100.61, "I"], [100.61, 100.85, "am"], [100.85, 101.03, "ready"], [101.03, 101.19, "to"], [101.19, 101.35, "come"], [101.35, 101.61, "home"], [101.61, 101.75, "and"], [101.75, 101.85, "see"], [101.85, 102.03, "my"], [102.03, 102.27, "friends"], [102.27, 102.43, "and"], [102.43, 102.63, "loved"], [102.63, 102.91, "ones,"]]}, {"start": 102.97, "end": 106.09, "text": " but I have to say if they could visit here I'd probably stay forever.", "words": [[102.97, 103.07, "but"], [103.07, 103.19, "I"], [103.19, 103.33, "have"], [103.33, 103.45, "to"], [103.45, 103.71, "say"], [103.71, 103.91, "if"], [103.91, 104.07, "they"], [104.07, 104.25, "could"], [104.25, 104.49, "visit"], [104.49, 104.85, "here"], [104.85, 105.15, "I'd"], [105.15, 105.43, "probably"], [105.43, 105.79, "stay"], [105.79, 106.09, "forever."]]}, {"start": 106.51, "end": 108.29, "text": " I absolutely love my job here.", "words": [[106.51, 106.77, "I"], [106.77, 107.09, "absolutely"], [107.09, 107.51, "love"], [107.51, 107.79, "my"], [107.79, 108.03, "job"], [108.03, 108.29, "here."]]}, {"start": 108.45, "end": 112.55, "text": " I love the ability to contribute and I love the work and I love the people.", "words": [[108.45, 108.53, "I"], [108.53, 108.71, "love"], [108.71, 108.87, "the"], [108.87, 109.11, "ability"], [109.11, 109.53, "to"], [109.53, 110.01, "contribute"], [110.01, 110.81, "and"], [110.81, 110.93, "I"], [110.93, 111.05, "love"], [111.05, 111.19, "the"], [111.19, 111.43, "work"], [111.43, 111.93, "and"], [111.93, 112.05, "I"], [112.05, 112.15, "love"], [112.15, 112.27, "the"], [112.27, 112.55, "people."]]}, {"start": 113.33, "end": 115.85, "text": " Do you have a favorite photo you've taken since you've been on station?", "words": [[113.33, 113.35, "Do"], [113.35, 113.47, "you"], [113.47, 113.65, "have"], [113.65, 113.77, "a"], [113.77, 114.03, "favorite"], [114.03, 114.31, "photo"], [114.31, 114.55, "you've"], [114.55, 114.79, "taken"], [114.79, 115.11, "since"], [115.11, 115.33, "you've"], [115.33, 115.43, "been"], [115.43, 115.55, "on"], [115.55, 115.85, "station?"]]}, {"start": 116.61, "end": 119.79, "text": " Well I'd have to say that photography is one of my favorite things", "words": [[116.61, 116.97, "Well"], [116.97, 117.23, "I'd"], [117.23, 117.29, "have"], [117.29, 117.45, "to"], [117.45, 117.71, "say"], [117.71, 117.95, "that"], [117.95, 118.39, "photography"], [118.39, 118.81, "is"], [118.81, 118.97, "one"], [118.97, 119.05, "of"], [119.05, 119.17, "my"], [119.17, 119.41, "favorite"], [119.41, 119.79, "things"]]}, {"start": 119.79, "end": 125.85, "text": " and this is my favorite thing to use in my free time to capture the Earth", "words": [[119.79, 120.39, "and"], [120.39, 122.15, "this"], [122.15, 122.43, "is"], [122.43, 122.59, "my"], [122.59, 122.87, "favorite"], [122.87, 123.23, "thing"], [123.23, 123.81, "to"], [123.81, 124.01, "use"], [124.01, 124.11, "in"], [124.11, 124.23, "my"], [124.23, 124.39, "free"], [124.39, 124.65, "time"], [124.65, 124.81, "to"], [124.81, 125.23, "capture"], [125.23, 125.61, "the"], [125.61, 125.85, "Earth"]]}, {"start": 125.85, "end": 128.53, "text": " and also the universe around the space station.", "words": [[125.85, 126.25, "and"], [126.25, 126.69, "also"], [126.69, 127.19, "the"], [127.19, 127.45, "universe"], [127.45, 127.83, "around"], [127.83, 127.99, "the"], [127.99, 128.15, "space"], [128.15, 128.53, "station."]]}, {"start": 128.81, "end": 133.65, "text": " If I had to pick just one picture, I would say it was a picture that I took", "words": [[128.81, 129.15, "If"], [129.15, 129.31, "I"], [129.31, 129.45, "had"], [129.45, 129.59, "to"], [129.59, 129.87, "pick"], [129.87, 130.21, "just"], [130.21, 130.49, "one"], [130.49, 130.85, "picture,"], [131.17, 131.31, "I"], [131.31, 131.47, "would"], [131.47, 131.79, "say"], [131.79, 132.57, "it"], [132.57, 132.69, "was"], [132.69, 132.81, "a"], [132.81, 133.01, "picture"], [133.01, 133.25, "that"], [133.25, 133.37, "I"], [133.37, 133.65, "took"]]}, {"start": 133.65, "end": 139.35, "text": " of the launch of Jessica Mir, Olyksa Kripochka, and Haza Almansori", "words": [[133.65, 134.23, "of"], [134.23, 134.39, "the"], [134.39, 134.73, "launch"], [134.73, 135.17, "of"], [135.17, 135.87, "Jessica"], [135.87, 136.27, "Mir,"], [136.71, 137.19, "Olyksa"], [137.19, 137.73, "Kripochka,"], [138.03, 138.11, "and"], [138.11, 138.67, "Haza"], [138.67, 139.35, "Almansori"]]}, {"start": 140.21, "end": 144.31, "text": " and it was a picture of them actually in the rocket", "words": [[140.21, 140.77, "and"], [140.77, 141.33, "it"], [141.33, 141.51, "was"], [141.51, 141.67, "a"], [141.67, 141.91, "picture"], [141.91, 142.35, "of"], [142.35, 142.61, "them"], [142.61, 143.21, "actually"], [143.21, 143.85, "in"], [143.85, 143.99, "the"], [143.99, 144.31, "rocket"]]}, {"start": 144.31, "end": 146.07, "text": " where the rocket almost looked like a star", "words": [[144.31, 144.51, "where"], [144.51, 144.63, "the"], [144.63, 144.89, "rocket"], [144.89, 145.21, "almost"], [145.21, 145.43, "looked"], [145.43, 145.61, "like"], [145.61, 145.77, "a"], [145.77, 146.07, "star"]]}, {"start": 146.07, "end": 151.73, "text": " and you could see a halo around it of the actual second stage as it started firing", "words": [[146.07, 146.45, "and"], [146.45, 146.55, "you"], [146.55, 146.71, "could"], [146.71, 146.95, "see"], [146.95, 147.09, "a"], [147.09, 147.37, "halo"], [147.37, 147.81, "around"], [147.81, 148.09, "it"], [148.09, 148.79, "of"], [148.79, 149.05, "the"], [149.05, 149.43, "actual"], [149.43, 149.85, "second"], [149.85, 150.31, "stage"], [150.31, 150.75, "as"], [150.75, 150.87, "it"], [150.87, 151.19, "started"], [151.19, 151.73, "firing"]]}, {"start": 151.73, "end": 156.49, "text": " and it was just such a symbol to me of achieving your dream.", "words": [[151.73, 152.81, "and"], [152.81, 153.11, "it"], [153.11, 153.25, "was"], [153.25, 153.37, "just"], [153.37, 153.61, "such"], [153.61, 153.75, "a"], [153.75, 153.95, "symbol"], [153.95, 154.23, "to"], [154.23, 154.51, "me"], [154.51, 155.09, "of"], [155.09, 155.83, "achieving"], [155.83, 156.11, "your"], [156.11, 156.49, "dream."]]}, {"start": 156.93, "end": 161.17, "text": " It was a beautiful thing that you could never see anywhere else other than here", "words": [[156.93, 157.09, "It"], [157.09, 157.23, "was"], [157.23, 157.39, "a"], [157.39, 157.65, "beautiful"], [157.65, 158.15, "thing"], [158.15, 158.73, "that"], [158.73, 159.21, "you"], [159.21, 159.37, "could"], [159.37, 159.57, "never"], [159.57, 159.87, "see"], [159.87, 160.15, "anywhere"], [160.15, 160.49, "else"], [160.49, 160.65, "other"], [160.65, 160.87, "than"], [160.87, 161.17, "here"]]}, {"start": 161.17, "end": 166.89, "text": " and it just sort of put a punctuation mark on the idea of a rocket launch", "words": [[161.17, 161.93, "and"], [161.93, 162.11, "it"], [162.11, 162.39, "just"], [162.39, 162.77, "sort"], [162.77, 163.05, "of"], [163.05, 163.81, "put"], [163.81, 163.95, "a"], [163.95, 164.33, "punctuation"], [164.33, 164.81, "mark"], [164.81, 165.25, "on"], [165.25, 165.77, "the"], [165.77, 166.05, "idea"], [166.05, 166.19, "of"], [166.19, 166.27, "a"], [166.27, 166.51, "rocket"], [166.51, 166.89, "launch"]]}, {"start": 166.89, "end": 170.57, "text": " and how awesome of a thing that is to be a part of", "words": [[166.89, 167.41, "and"], [167.41, 167.89, "how"], [167.89, 168.35, "awesome"], [168.35, 168.59, "of"], [168.59, 168.71, "a"], [168.71, 168.91, "thing"], [168.91, 169.19, "that"], [169.19, 169.47, "is"], [169.47, 169.69, "to"], [169.69, 169.91, "be"], [169.91, 170.11, "a"], [170.11, 170.33, "part"], [170.33, 170.57, "of"]]}, {"start": 170.57, "end": 172.63, "text": " and to be able to actually witness with your own eyes.", "words": [[170.57, 170.77, "and"], [170.77, 170.87, "to"], [170.87, 170.97, "be"], [170.97, 171.09, "able"], [171.09, 171.19, "to"], [171.19, 171.43, "actually"], [171.43, 171.71, "witness"], [171.71, 172.01, "with"], [172.01, 172.17, "your"], [172.17, 172.35, "own"], [172.35, 172.63, "eyes."]]}, {"start": 172.63, "end": 179.99, "text": " What a great question, something that we call expeditionary skills behaviors", "words": [[172.63, 173.67, "What"], [176.29, 176.41, "a"], [176.41, 176.61, "great"], [176.61, 177.07, "question,"], [177.31, 177.67, "something"], [177.67, 177.89, "that"], [177.89, 178.07, "we"], [178.07, 178.31, "call"], [178.31, 179.21, "expeditionary"], [179.21, 179.51, "skills"], [179.51, 179.99, "behaviors"]]}, {"start": 179.99, "end": 185.35, "text": " and what that means is it's a set of skills that is important for being productive", "words": [[179.99, 180.93, "and"], [180.93, 181.15, "what"], [181.15, 181.37, "that"], [181.37, 181.59, "means"], [181.59, 181.95, "is"], [181.95, 182.25, "it's"], [182.25, 182.33, "a"], [182.33, 182.61, "set"], [182.61, 182.75, "of"], [182.75, 183.05, "skills"], [183.05, 183.47, "that"], [183.47, 183.71, "is"], [183.71, 184.13, "important"], [184.13, 184.53, "for"], [184.53, 184.87, "being"], [184.87, 185.35, "productive"]]}, {"start": 185.35, "end": 190.51, "text": " and doing your best in a close environment that is not something you're accustomed to on the Earth", "words": [[185.35, 185.91, "and"], [185.91, 186.15, "doing"], [186.15, 186.35, "your"], [186.35, 186.67, "best"], [186.67, 186.95, "in"], [186.95, 187.11, "a"], [187.11, 187.51, "close"], [187.51, 188.07, "environment"], [188.07, 188.55, "that"], [188.55, 188.71, "is"], [188.71, 188.95, "not"], [188.95, 189.31, "something"], [189.31, 189.53, "you're"], [189.53, 189.81, "accustomed"], [189.81, 190.05, "to"], [190.05, 190.23, "on"], [190.23, 190.33, "the"], [190.33, 190.51, "Earth"]]}, {"start": 190.51, "end": 192.05, "text": " such as the space station.", "words": [[190.51, 190.91, "such"], [190.91, 191.19, "as"], [191.19, 191.47, "the"], [191.47, 191.61, "space"], [191.61, 192.05, "station."]]}, {"start": 192.31, "end": 198.43, "text": " Leadership, followership, group, living, team care, self-care, communication,", "words": [[192.31, 192.61, "Leadership,"], [193.13, 193.85, "followership,"], [194.23, 194.65, "group,"], [195.03, 195.37, "living,"], [195.91, 196.11, "team"], [196.11, 196.55, "care,"], [196.97, 197.17, "self"], [197.17, 197.57, "-care,"], [197.95, 198.43, "communication,"]]}, {"start": 199.15, "end": 203.41, "text": " things that allow you and your crewmates to basically work at your best", "words": [[199.15, 199.43, "things"], [199.43, 199.61, "that"], [199.61, 199.89, "allow"], [199.89, 200.29, "you"], [200.29, 200.77, "and"], [200.77, 200.95, "your"], [200.95, 201.39, "crewmates"], [201.39, 201.75, "to"], [201.75, 202.11, "basically"], [202.11, 202.49, "work"], [202.49, 202.91, "at"], [202.91, 203.07, "your"], [203.07, 203.41, "best"]]}, {"start": 203.41, "end": 205.47, "text": " every single day and still get the mission done.", "words": [[203.41, 203.71, "every"], [203.71, 203.99, "single"], [203.99, 204.27, "day"], [204.27, 204.51, "and"], [204.51, 204.69, "still"], [204.69, 204.83, "get"], [204.83, 204.93, "the"], [204.93, 205.17, "mission"], [205.17, 205.47, "done."]]}, {"start": 209.88, "end": 214.08, "text": " There is so much out of this world science going on up here, it's really exciting.", "words": [[209.88, 210.24, "There"], [210.24, 210.56, "is"], [210.56, 210.86, "so"], [210.86, 211.1, "much"], [211.1, 211.28, "out"], [211.28, 211.38, "of"], [211.38, 211.54, "this"], [211.54, 211.72, "world"], [211.72, 212.04, "science"], [212.04, 212.34, "going"], [212.34, 212.6, "on"], [212.6, 212.74, "up"], [212.74, 212.9, "here,"], [213.04, 213.2, "it's"], [213.2, 213.62, "really"], [213.62, 214.08, "exciting."]]}, {"start": 214.68, "end": 220.02, "text": " If you can imagine anything that happens to just be better served", "words": [[214.68, 214.9, "If"], [214.9, 215.04, "you"], [215.04, 215.2, "can"], [215.2, 215.66, "imagine"], [215.66, 216.36, "anything"], [216.36, 217.26, "that"], [217.26, 217.74, "happens"], [217.74, 217.98, "to"], [217.98, 218.22, "just"], [218.22, 218.56, "be"], [218.56, 219.38, "better"], [219.38, 220.02, "served"]]}, {"start": 220.02, "end": 223.66, "text": " as a scientific question in microgravity than it does on the Earth,", "words": [[220.02, 220.38, "as"], [220.38, 220.56, "a"], [220.56, 221.16, "scientific"], [221.16, 221.76, "question"], [221.76, 221.98, "in"], [221.98, 222.72, "microgravity"], [222.72, 222.9, "than"], [222.9, 223.02, "it"], [223.02, 223.16, "does"], [223.16, 223.36, "on"], [223.36, 223.48, "the"], [223.48, 223.66, "Earth,"]]}, {"start": 224.04, "end": 225.18, "text": " we can do that up here.", "words": [[224.04, 224.28, "we"], [224.28, 224.5, "can"], [224.5, 224.64, "do"], [224.64, 224.82, "that"], [224.82, 224.98, "up"], [224.98, 225.18, "here."]]}, {"start": 225.46, "end": 229.38, "text": " So that covers all kinds of realms of science including biology, biotechnology,", "words": [[225.46, 225.62, "So"], [225.62, 225.78, "that"], [225.78, 226.02, "covers"], [226.02, 226.38, "all"], [226.38, 226.58, "kinds"], [226.58, 226.76, "of"], [226.76, 226.92, "realms"], [226.92, 227.14, "of"], [227.14, 227.46, "science"], [227.46, 227.94, "including"], [227.94, 228.6, "biology,"], [228.88, 229.38, "biotechnology,"]]}, {"start": 230.24, "end": 233.54, "text": " physical science, earth and space science, technology demonstrations", "words": [[230.24, 230.5, "physical"], [230.5, 231.02, "science,"], [231.26, 231.46, "earth"], [231.46, 231.6, "and"], [231.6, 231.8, "space"], [231.8, 232.42, "science,"], [232.58, 233.1, "technology"], [233.1, 233.54, "demonstrations"]]}, {"start": 233.96, "end": 235.96, "text": " and even human research on our own bodies.", "words": [[233.96, 234.2, "and"], [234.2, 234.4, "even"], [234.4, 234.72, "human"], [234.72, 235.16, "research"], [235.16, 235.44, "on"], [235.44, 235.56, "our"], [235.56, 235.66, "own"], [235.66, 235.96, "bodies."]]}, {"start": 235.96, "end": 241.46, "text": " One of the most exciting pieces of science that I've had the opportunity to be involved in", "words": [[235.96, 236.82, "One"], [236.82, 236.96, "of"], [236.96, 237.04, "the"], [237.04, 237.34, "most"], [237.34, 238.14, "exciting"], [238.14, 238.66, "pieces"], [238.66, 238.88, "of"], [238.88, 239.18, "science"], [239.18, 239.44, "that"], [239.44, 239.78, "I've"], [239.78, 239.86, "had"], [239.86, 239.98, "the"], [239.98, 240.38, "opportunity"], [240.38, 240.66, "to"], [240.66, 240.88, "be"], [240.88, 241.2, "involved"], [241.2, 241.46, "in"]]}, {"start": 241.46, "end": 246.14, "text": " is directed towards developing medicines for fighting some of the diseases that we all face.", "words": [[241.46, 241.78, "is"], [241.78, 242.08, "directed"], [242.08, 242.5, "towards"], [242.5, 243.12, "developing"], [243.12, 243.62, "medicines"], [243.62, 243.96, "for"], [243.96, 244.24, "fighting"], [244.24, 244.5, "some"], [244.5, 244.62, "of"], [244.62, 244.74, "the"], [244.74, 245.12, "diseases"], [245.12, 245.48, "that"], [245.48, 245.64, "we"], [245.64, 245.84, "all"], [245.84, 246.14, "face."]]}, {"start": 247.52, "end": 251.1, "text": " You know, I think that's a question that we're all looking to answer right now.", "words": [[247.52, 248.04, "You"], [248.04, 248.16, "know,"], [248.22, 248.32, "I"], [248.32, 248.48, "think"], [248.48, 248.76, "that's"], [248.76, 248.84, "a"], [248.84, 249.2, "question"], [249.2, 249.44, "that"], [249.44, 249.6, "we're"], [249.6, 249.82, "all"], [249.82, 250.08, "looking"], [250.08, 250.32, "to"], [250.32, 250.6, "answer"], [250.6, 250.88, "right"], [250.88, 251.1, "now."]]}, {"start": 251.24, "end": 253.72, "text": " There's so many different factors that go into that question", "words": [[251.24, 251.46, "There's"], [251.46, 251.7, "so"], [251.7, 251.88, "many"], [251.88, 252.14, "different"], [252.14, 252.52, "factors"], [252.52, 252.82, "that"], [252.82, 252.98, "go"], [252.98, 253.16, "into"], [253.16, 253.34, "that"], [253.34, 253.72, "question"]]}, {"start": 253.72, "end": 259.52, "text": " and the real answer is I think we're not necessarily limited fundamentally by any one thing.", "words": [[253.72, 254.3, "and"], [254.3, 254.42, "the"], [254.42, 254.64, "real"], [254.64, 254.98, "answer"], [254.98, 255.22, "is"], [255.22, 255.34, "I"], [255.34, 255.54, "think"], [255.54, 255.98, "we're"], [255.98, 256.16, "not"], [256.16, 256.62, "necessarily"], [256.62, 257.4, "limited"], [257.4, 258.02, "fundamentally"], [258.02, 258.66, "by"], [258.66, 258.96, "any"], [258.96, 259.2, "one"], [259.2, 259.52, "thing."]]}, {"start": 259.78, "end": 263.32, "text": " It's really just a question of where can our technology and our innovation take us.", "words": [[259.78, 260.06, "It's"], [260.06, 260.22, "really"], [260.22, 260.42, "just"], [260.42, 260.58, "a"], [260.58, 260.8, "question"], [260.8, 261.02, "of"], [261.02, 261.2, "where"], [261.2, 261.38, "can"], [261.38, 261.46, "our"], [261.46, 262.02, "technology"], [262.02, 262.26, "and"], [262.26, 262.38, "our"], [262.38, 262.68, "innovation"], [262.68, 263.06, "take"], [263.06, 263.32, "us."]]}, {"start": 263.32, "end": 267.56, "text": " One of the reasons I'm so happy that I've had the opportunity to do an extended mission", "words": [[263.32, 264.06, "One"], [264.06, 264.18, "of"], [264.18, 264.28, "the"], [264.28, 264.5, "reasons"], [264.5, 264.8, "I'm"], [264.8, 265.04, "so"], [265.04, 265.32, "happy"], [265.32, 265.52, "that"], [265.52, 265.7, "I've"], [265.7, 265.78, "had"], [265.78, 265.9, "the"], [265.9, 266.3, "opportunity"], [266.3, 266.68, "to"], [266.68, 266.78, "do"], [266.78, 266.92, "an"], [266.92, 267.2, "extended"], [267.2, 267.56, "mission"]]}, {"start": 267.56, "end": 269.72, "text": " is that that contributes to that understanding.", "words": [[267.56, 268.02, "is"], [268.02, 268.16, "that"], [268.16, 268.28, "that"], [268.28, 268.74, "contributes"], [268.74, 269.0, "to"], [269.0, 269.18, "that"], [269.18, 269.72, "understanding."]]}, {"start": 272.34, "end": 278.92, "text": " Definitely the best thing is that you get a chance to contribute to the coolest work being done", "words": [[272.34, 272.86, "Definitely"], [272.86, 273.38, "the"], [273.38, 273.62, "best"], [273.62, 273.94, "thing"], [273.94, 274.26, "is"], [274.26, 274.46, "that"], [274.46, 274.7, "you"], [274.7, 274.86, "get"], [274.86, 275.06, "a"], [275.06, 275.3, "chance"], [275.3, 275.6, "to"], [275.6, 276.02, "contribute"], [276.02, 276.4, "to"], [276.4, 276.64, "the"], [276.64, 277.04, "coolest"], [277.04, 277.98, "work"], [277.98, 278.6, "being"], [278.6, 278.92, "done"]]}, {"start": 278.92, "end": 281.18, "text": " in my opinion by all of humanity.", "words": [[278.92, 279.22, "in"], [279.22, 279.44, "my"], [279.44, 279.76, "opinion"], [279.76, 280.24, "by"], [280.24, 280.64, "all"], [280.64, 280.76, "of"], [280.76, 281.18, "humanity."]]}, {"start": 281.72, "end": 286.6, "text": " I have held this, you know, human spaceflight in such high regard my entire life", "words": [[281.72, 281.96, "I"], [281.96, 282.24, "have"], [282.24, 282.7, "held"], [282.7, 283.1, "this,"], [283.2, 283.62, "you"], [283.62, 283.76, "know,"], [283.82, 284.12, "human"], [284.12, 284.76, "spaceflight"], [284.76, 284.92, "in"], [284.92, 285.1, "such"], [285.1, 285.36, "high"], [285.36, 285.64, "regard"], [285.64, 285.9, "my"], [285.9, 286.16, "entire"], [286.16, 286.6, "life"]]}, {"start": 286.6, "end": 290.7, "text": " and so to get the opportunity to actually contribute to it day in and day out", "words": [[286.6, 286.78, "and"], [286.78, 287.0, "so"], [287.0, 287.18, "to"], [287.18, 287.36, "get"], [287.36, 287.5, "the"], [287.5, 287.9, "opportunity"], [287.9, 288.32, "to"], [288.32, 288.76, "actually"], [288.76, 289.28, "contribute"], [289.28, 289.56, "to"], [289.56, 289.74, "it"], [289.74, 289.96, "day"], [289.96, 290.14, "in"], [290.14, 290.24, "and"], [290.24, 290.42, "day"], [290.42, 290.7, "out"]]}, {"start": 290.7, "end": 292.94, "text": " is by far the best part about being up here.", "words": [[290.7, 291.14, "is"], [291.14, 291.32, "by"], [291.32, 291.54, "far"], [291.54, 291.66, "the"], [291.66, 291.88, "best"], [291.88, 292.08, "part"], [292.08, 292.3, "about"], [292.3, 292.54, "being"], [292.54, 292.8, "up"], [292.8, 292.94, "here."]]}, {"start": 292.94, "end": 296.26, "text": " Now second I would say is definitely being able to float.", "words": [[292.94, 293.56, "Now"], [293.56, 294.16, "second"], [294.16, 294.44, "I"], [294.44, 294.58, "would"], [294.58, 294.82, "say"], [294.82, 295.06, "is"], [295.06, 295.42, "definitely"], [295.42, 295.7, "being"], [295.7, 295.92, "able"], [295.92, 296.02, "to"], [296.02, 296.26, "float."]]}, {"start": 299.58, "end": 301.42, "text": " Microgravity sure makes it fun to get around.", "words": [[299.58, 300.1, "Microgravity"], [300.1, 300.3, "sure"], [300.3, 300.48, "makes"], [300.48, 300.66, "it"], [300.66, 300.8, "fun"], [300.8, 300.96, "to"], [300.96, 301.08, "get"], [301.08, 301.42, "around."]]}, {"start": 301.9, "end": 305.18, "text": " Here on the space station we have to work in every orientation.", "words": [[301.9, 302.02, "Here"], [302.02, 302.14, "on"], [302.14, 302.26, "the"], [302.26, 302.42, "space"], [302.42, 302.78, "station"], [302.78, 303.14, "we"], [303.14, 303.72, "have"], [303.72, 303.84, "to"], [303.84, 304.06, "work"], [304.06, 304.38, "in"], [304.38, 304.68, "every"], [304.68, 305.18, "orientation."]]}, {"start": 305.56, "end": 306.84, "text": " We have stowage on the ceiling.", "words": [[305.56, 305.58, "We"], [305.58, 305.76, "have"], [305.76, 306.28, "stowage"], [306.28, 306.44, "on"], [306.44, 306.56, "the"], [306.56, 306.84, "ceiling."]]}, {"start": 307.08, "end": 308.8, "text": " We have science experiments on the ceiling", "words": [[307.08, 307.12, "We"], [307.12, 307.28, "have"], [307.28, 307.58, "science"], [307.58, 308.06, "experiments"], [308.06, 308.36, "on"], [308.36, 308.52, "the"], [308.52, 308.8, "ceiling"]]}, {"start": 308.8, "end": 314.46, "text": " and so it's pretty fun to be able to float around to flip around just to get around.", "words": [[308.8, 309.34, "and"], [309.34, 309.54, "so"], [309.54, 309.74, "it's"], [309.74, 309.92, "pretty"], [309.92, 310.18, "fun"], [310.18, 310.34, "to"], [310.34, 310.42, "be"], [310.42, 310.58, "able"], [310.58, 310.68, "to"], [310.68, 310.86, "float"], [310.86, 311.26, "around"], [311.26, 312.08, "to"], [312.08, 312.3, "flip"], [312.3, 312.78, "around"], [312.78, 313.76, "just"], [313.76, 314.02, "to"], [314.02, 314.18, "get"], [314.18, 314.46, "around."]]}, {"start": 320.07, "end": 321.59, "text": " Do you have a question for NASA?", "words": [[320.07, 320.53, "Do"], [320.53, 320.61, "you"], [320.61, 320.73, "have"], [320.73, 320.81, "a"], [320.81, 321.09, "question"], [321.09, 321.33, "for"], [321.33, 321.59, "NASA?"]]}, {"start": 322.13, "end": 326.23, "text": " Send you